# credentials — never commit
.env
.env.*

# hook registration: project-local, must not travel to clones or cloud sessions
.claude/settings.local.json

# kill switch is a local runtime flag
.jev-disabled

# collected data, spool, logs — local only, never published from git
#
# NOTE the `data/*` rather than `data/`. git cannot re-include a path beneath an
# EXCLUDED DIRECTORY, so the previous `data/` plus `!data/fixtures/...` carve-out
# below was inert: `git check-ignore -v data/fixtures/canary-set-v1.json`
# reported `.gitignore:12:data/`, and `git ls-files data/` was empty — the
# pre-registered canary set was never actually committed. Excluding the
# directory's CONTENTS instead makes the negations work. Found 2026-09-20 by
# JEV-38, which depends on the same precedent.
data/*
# ...except the canary's frozen state set. It is a PRE-REGISTERED commitment —
# the fixed bytes re-sent daily to detect vendor drift — and a pre-registered
# fixture that is not under version control cannot be audited. It is safe to
# commit: the states are synthetic (we wrote them), and the synthetic set is
# already inside the publication scope. Its id is content-derived, so a
# hand-edit is refused rather than silently compared against.
!data/fixtures/
data/fixtures/*
!data/fixtures/canary-set-v1.json
# ...and except the persisted "before" baseline (JEV-38). data/ is gitignored
# for state blobs; this is aggregate, carries DERIVED NUMBERS ONLY — no
# third-party transcript content — and is the one artifact that must survive
# losing this folder, because its source lives in ~/.claude/projects/ under a
# 30-day retention sweep we do not control.
!data/baseline/
data/baseline/*
!data/baseline/sessions.jsonl
!data/baseline/manifest.json
!data/baseline/delegation-pre-rule-v1.json
spool/
logs/
# reports/ is deliberately NOT ignored: reports are the publishable artifact,
# and they carry aggregate statistics only -- never state blobs, which stay in
# the gitignored data/states/ and are excluded from any export.

# python
__pycache__/
*.pyc
.venv/
